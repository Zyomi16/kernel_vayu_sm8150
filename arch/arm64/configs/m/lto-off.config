# Tat LTO: ve LTO_NONE (defconfig goc).
# merge_config.sh xu ly duoc dong "# CONFIG_X is not set" (SED_CONFIG_EXP
# khop `\(# \)\{0,1\}`), olddefconfig se giai quyet choice LTO.
# KHONG viet comment bat dau bang "# CONFIG_" o day (bi doc nham thanh
# assignment) va khong comment cuoi dong assignment.
# CONFIG_LTO_CLANG is not set
# CONFIG_THINLTO is not set
CONFIG_LTO_NONE=y
