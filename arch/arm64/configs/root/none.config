# Yomi16 variant: KHONG root.
#
# Defconfig goc da bat KSU san nen PHAI tat tuong minh o day.
# merge_config.sh chi ghi de, khong tu bo duoc config cu → tat bang "=n".
# (Khong viet ten symbol kem dau bang trong comment: grep -w cua
# merge_config.sh se quet nham vao "New value" hien tren log.)
CONFIG_KSU=n
CONFIG_KSU_MANUAL_HOOK=n
CONFIG_KSU_SUSFS=n
CONFIG_KSU_TRACEPOINT_HOOK=n
CONFIG_KSU_MULTI_MANAGER_SUPPORT=n
CONFIG_KSU_MANUAL_SU=n
CONFIG_KPM=n
