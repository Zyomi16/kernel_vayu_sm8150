# Yomi16 variant: SukiSU-Ultra, MultiManager mac dinh, KPM TAT
#
# SukiSU-Ultra khong co symbol KSU_MULTI_MANAGER_SUPPORT. No ho tro nhieu
# manager bang cach KHONG disable: config KSU_DISABLE_MANAGER default n.
CONFIG_KSU=y
# "Use manual su" — tuong duong KSU_MANUAL_HOOK cua ReSukiSU.
CONFIG_KSU_MANUAL_SU=y
# KPM: default n, "may affect system stability" (theo help cua no).
# Bat o variant sukisu-kpm.config.
# CONFIG_KPM khong ghi o day = default n.
