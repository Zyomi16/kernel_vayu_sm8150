# Yomi16 variant: ReSukiSU + MultiManager (KHONG SUSFS)
#
# KSU_TRACEPOINT_HOOK chi ho tro GKI2 5.10+ (drivers/kernelsu/Kconfig:88
# help: "Support for kernel 5.10+"). Cay nay la 4.14 non-GKI → choice chi
# co the chon KSU_MANUAL_HOOK ("Support for kernel 3.4+").
# => 6 patch thu cong trong fs/stat.c, fs/open.c, fs/exec.c, kernel/reboot.c
#    la BAT BUOC, khong bo duoc.
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
# MultiManager: cho phep nhieu app manager cung root.
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
