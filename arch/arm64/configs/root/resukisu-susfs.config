# Yomi16 variant: ReSukiSU + MultiManager + SUSFS
#
# KSU_SUSFS va KSU_MANUAL_HOOK cung thuoc MOT choice (drivers/kernelsu/Kconfig
# :80 choice, :96 MANUAL_HOOK, :104 SUSFS) → chi chon 1. Bang config nay
# chon SUSFS, nen 6 patch thu cong se KHONG duoc build dung (fs/susfs.o
# moi bien dich). Kbuild cua fork phai chua call site rieng cho SUSFS —
# xem drivers/kernelsu/Kconfig:169+ (11 option KSU_SUSFS_*).
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
